# Copy to .env and fill in real values. Never commit .env.
# Only vars prefixed VITE_ are exposed to client-side code (see LESSONS.md).

VITE_API_BASE_URL=http://localhost:3000/api

# Must match the backend's ADMIN_API_KEY exactly — sent as a Bearer token on
# compliance-requirements add/edit/delete requests (see services/requirementsService.js).
# This ships in the public bundle like every VITE_ var — see LESSONS.md's note on that.
VITE_ADMIN_API_KEY=your-admin-api-key

VITE_AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
VITE_AZURE_AD_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173
